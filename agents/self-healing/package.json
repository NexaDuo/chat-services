{
  "name": "@nexaduo/self-healing-agent",
  "version": "1.0.0",
  "description": "LLM-powered self-healing agent for NexaDuo",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --require ./dist/telemetry.js dist/index.js",
    "dev": "node -r ts-node/register -r ./src/telemetry.ts src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-pino": "^0.68.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "axios": "^1.20.0",
    "pg": "^8.23.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
